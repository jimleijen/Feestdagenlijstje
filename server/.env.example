# Local dev database (SQLite file). Point this at Postgres in production.
DATABASE_URL="file:./dev.db"

PORT=4000
JWT_SECRET="change-me-in-production"

# SMTP for the "wie heb ik?" e-mails after a draw is run.
# In development, if these are left empty, the mailer logs the e-mail to the console instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Feestdagenlijstje <no-reply@feestdagenlijstje.app>"

# --- Affiliate API keys for accurate, live webshop pricing ---
# Only providers with a key configured are queried; scraping is intentionally not used
# (it is exactly what causes lijstje.nl-style "price on the app != price on the site" bugs).
BOL_PARTNER_API_KEY=
COOLBLUE_AFFILIATE_API_KEY=
AMAZON_PA_API_ACCESS_KEY=
AMAZON_PA_API_SECRET_KEY=
AMAZON_PA_API_PARTNER_TAG=
